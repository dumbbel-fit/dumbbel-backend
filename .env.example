ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DB?ssl-mode=REQUIRED
AUTO_CREATE_TABLES=true

JWT_SECRET=change-me
QR_KEYS=DBF1:change-me
QR_CURRENT_KID=DBF1

# 2Factor.in — paste your API key (2factor.in dashboard). Without it OTPs are printed in the server log.
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=Dumbble
TWOFACTOR_SENDER_ID=DMBL
TWOFACTOR_OTP_ROUTE=v1
# Optional DLT template for gym-status SMS (owners already get a push notification)
TWOFACTOR_TPL_GYM_STATUS=

# Dev only: a fixed OTP that always works and skips SMS (never honoured when ENV=production)
OTP_DEV_CODE=

# Optional
REDIS_URL=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EXPO_ACCESS_TOKEN=
RUN_SCHEDULER=true
CORS_ORIGINS=

# Phone login: firebase | 2factor
AUTH_PROVIDER=firebase
# Firebase Phone Auth (POST /v1/auth/firebase)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_CREDENTIALS_FILE=

# Groq (AI coach, food estimates, briefing)
GROQ_API_KEY=
GROQ_MODEL=

# WhatsApp — see docs/WHATSAPP.md
# QR linking (Evolution API, free)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Official Meta Cloud API (optional)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ENC_KEY=
META_APP_ID=
META_ES_CONFIG_ID=
RENEW_URL_BASE=https://dumbbel.fit/renew
