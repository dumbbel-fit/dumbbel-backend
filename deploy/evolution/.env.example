# Copy to .env on the VM (setup-vm.sh does this and fills the secrets for you).
# Sub-domain pointing at this VM's IP (A record), e.g. wa.dumbbel.fit
WA_DOMAIN=wa.dumbbel.fit
# Long random string. Put the SAME value in the DUMBBEL backend as EVOLUTION_API_KEY. Never in the frontend.
EVOLUTION_API_KEY=
PG_PASSWORD=
